<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - RivneSheltersProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/RivneSheltersProject.styles.css" asp-append-version="true"/>
     <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
     <style>
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                background-color: #f8f9fa;
            }
            .header, .footer {
                background-color: #343a40;
                color: white;
                padding: 10px 20px;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .header .title {
                font-size: 24px;
            }
            .header .admin-icon {
                cursor: pointer;
            }
            #map {
                width: 100%;
                height: 500px;
                flex: 1;
            }
            .container {
                padding: 20px;
                text-align: center;
            }
            .route-btn {
                margin-top: 20px;
                padding: 10px 20px;
                font-size: 18px;
                cursor: pointer;
                background-color: #007bff;
                color: white;
                border: none;
                border-radius: 5px;
            }
            .route-btn:hover {
                background-color: #0056b3;
            }
            .modal-content {
                padding: 20px;
            }
            .container {
                flex: 1; /* Додається, щоб забезпечити заповнення вільного простору */
                padding: 20px;
                text-align: center;
            }
            
            .footer {
                background-color: #343a40;
                color: white;
                padding: 10px;
                text-align: center;
            }
            .header .navbar-brand {
                color: white;
                font-size: 24px;
                text-decoration: none;
            }
            
            .header .navbar-brand:hover {
                color: #cccccc; 
            }
        </style>
</head>
<body>
<header>
    @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3"> *@
    @*     <div class="container-fluid"> *@
    @*         <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RivneSheltersProject</a> *@
    @*         <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" *@
    @*                 aria-expanded="false" aria-label="Toggle navigation"> *@
    @*             <span class="navbar-toggler-icon"></span> *@
    @*         </button> *@
    @*         <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between"> *@
    @*             <ul class="navbar-nav flex-grow-1"> *@
    @*                 <li class="nav-item"> *@
    @*                     <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a> *@
    @*                 </li> *@
    @*                 <li class="nav-item"> *@
    @*                     <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
    @*                 </li> *@
    @*             </ul> *@
    @*             <partial name="_LoginPartial"/> *@
    @*         </div> *@
    @*     </div> *@
    @* </nav> *@
    <div class="header">
        <div class="title">
            <a class="navbar-brand" asp-controller="Home" asp-action="Rivne">Укриття Рівне</a>
        </div>
        <partial name="_LoginPartial"/>
    </div>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<div class="footer">
    <p>&copy; 2026 Укриття Рівне. Всі права захищені.</p>
    <a asp-area="" asp-controller="Home" asp-action="Privacy" style=" color: white;">Політика конфіденційності</a>
    <a asp-area="" asp-controller="Home" asp-action="Terms" style=" color: white;">Умови користування</a>
    <a asp-area="" asp-controller="Home" asp-action="About" style=" color: white;">Про нас</a>
    @* <a href="/privacy-policy">Політика конфіденційності</a> | *@
    @* <a href="/terms-and-conditions">Умови користування</a> | *@
    @* <a href="/about-us">Про нас</a> *@
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>